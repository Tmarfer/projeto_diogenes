# ── PROVIDER ─────────────────────────────────────────────────────────────────
# ÚNICO VALOR PERMITIDO — dados fiscais só trafegam pela infraestrutura do TCU
DIOGENES_LLM_PROVIDER=chattcu

# ── CHATTCU — URL ─────────────────────────────────────────────────────────────
# De casa ou sem VPN (URL de produção pública):
DIOGENES_CHATTCU_BASE_URL=https://chat-tcu.apps.tcu.gov.br

# Dentro da rede TCU ou com VPN (URL de desenvolvimento):
# DIOGENES_CHATTCU_BASE_URL=http://chattcu-desenvol.desenvol.rancher.tcu.gov.br

# Sem API key — autenticação via MSAL (browser abre na primeira execução)

# ── WORKSPACE ─────────────────────────────────────────────────────────────────
DIOGENES_WORKSPACE=/caminho/para/seu/workspace

# ── IRENE ─────────────────────────────────────────────────────────────────────
IRENE_PROVIDER=chattcu
IRENE_MODEL=Claude 4.6 Sonnet
IRENE_CHATTCU_BASE_URL=https://chat-tcu.apps.tcu.gov.br
DIOGENES_IRENE_HABILITADO=true

# Irene C3: desabilitar Excel MCP Server (usar openpyxl direto)
# Se vazio ou ausente, Irene usa leitura direta via openpyxl (recomendado)
IRENE_EXCEL_MCP_COMMAND=
EXCEL_MCP_PAGING_CELLS_LIMIT=4000

# ── MODELOS (definidos em agents_spec.yaml — não alterar aqui) ───────────────
# Mycroft:  Claude 4.6 Sonnet
# Watson:   gemini-3.1-flash-lite
# Sherlock: gpt-5.4-thinking
# Irene C4: Claude 4.6 Sonnet
