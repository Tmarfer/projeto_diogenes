# .env.example — DVA-CBS | Projeto Diógenes
# TC 015.848/2025-6 | TCU / SecexContas
#
# INSTRUÇÕES:
#   1. Copie este arquivo para .env
#   2. Preencha os valores reais
#   3. NUNCA versione o .env — está listado no .gitignore
#
# Referência normativa: RNF-SEGU-01 e 02 (PRD v0.1), Bloco 4 (SDD v0.1)

# ---------------------------------------------------------------------------
# LLM Provider — chave e endpoint
# Piloto local (Fases A, B, D): OpenRouter
#   DIOGENES_LLM_BASE_URL=https://openrouter.ai/api/v1
#   DIOGENES_LLM_API_KEY=<chave OpenRouter — obter em openrouter.ai/keys>
#
# Produção (pós-piloto): Azure AI Foundry
#   DIOGENES_LLM_BASE_URL=<endpoint do Foundry>
#   DIOGENES_LLM_API_KEY=<token Managed Identity ou Service Principal>
# ---------------------------------------------------------------------------
DIOGENES_LLM_BASE_URL=https://openrouter.ai/api/v1
DIOGENES_LLM_API_KEY=

# Identificadores para o OpenRouter (recomendados para rate limit e logs)
DIOGENES_OPENROUTER_SITE_URL=https://github.com/tcu/diogenes
DIOGENES_OPENROUTER_APP_NAME=DVA-CBS Projeto Diogenes

# ---------------------------------------------------------------------------
# Workspace — caminho absoluto do diretório de trabalho do Departamento
# Sobrescreve runtime.yaml::workspace.path quando definido.
#
# Exemplos:
#   Local Linux/macOS:  /Users/nome/diogenes_workspace
#   Local Windows:      C:\Users\nome\diogenes_workspace
#   OneDrive (macOS):   /Users/nome/Library/CloudStorage/OneDrive-TCU/diogenes_workspace
#   VPS:                /opt/diogenes/workspace
# ---------------------------------------------------------------------------
DIOGENES_WORKSPACE=

# ---------------------------------------------------------------------------
# Ambiente de execução
# Valores: local | vps | azure
# Usado para logs e identificação nos traces (RNF-REPR)
# ---------------------------------------------------------------------------
DIOGENES_ENV=local
